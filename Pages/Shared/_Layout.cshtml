<!DOCTYPE html>
<html lang="en">
    <!-- Header -->
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>@ViewData["Title"] - Malachi McCloud</title>
        <!-- Pulls the Tailwind CSS page built earlier. -->
        <link rel="stylesheet" href="~/css/dist/site.css" />
    </head>



    <!-- Uses tailwind to set lightgray background then text to a darker color antialiased for smoother font render -->
    <body class="bg-neutral-50 text-neutral-900 antialiased">
        <header class="border-b border-neutral-200"> <!--Subtle border-->
        <nav class="max-w-3xl mx-auto px-4 py-4 flex items-center justify-between"> <!-- Centers content limits to readable width -->
            <a href="/" class="text-xl font-semibold tracking-tight">
            Malachi McCloud
            </a>

            <!-- Site Nav -->
            <div class="flex gap-6 text-sm">
                <a href="/" class="hover:text-blue-600 transition">Home</a>
                <a href="/Projects" class="hover:text-blue-600 transition">Projects</a>
                <a href="/Log" class="hover:text-blue-600 transition">Log</a>
                <a href="/Resume" class="hover:text-blue-600 transition">Resume</a>
            </div>
        </nav>
    </header>
        
    <!-- Main  -->
    <main class="max-w-3xl mx-auto px-4 py-10"> <!-- Semantic tag, center like header padding so it doesn't hug edges -->
        @RenderBody()
        </main>
        
    <!-- Footer -->
    <footer class="border-t border-neutral-200 mt-10">
        <div class="max-w-3xl mx-auto px-4 py-6 text-sm text-neutral-500">
            © @DateTime.Now.Year · Built by Malachi · Powered by ASP.NET Core + Tailwind
        </div>
    </footer>

    @RenderSection("Scripts", required: false)
    </body>

    
</html>